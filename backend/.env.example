# 茶·图鉴 后端环境变量示例
# 复制为 .env 后按本地环境修改；.env 不进 Git（.gitignore 已覆盖）

# === 基础 ===
DEBUG=true
TEA_PROFILE=local

# === 数据库（MySQL 5.7.19） ===
TEA_DB_HOST=localhost
TEA_DB_PORT=3306
TEA_DB_USER=root
TEA_DB_PASSWORD=root
TEA_DB_NAME=tea_guide

# 测试库（可选）：pytest 默认使用 tea_guide_test；如需自定义连接串可设置该变量
# DATABASE_URL_TEST=mysql+pymysql://root:root@localhost:3306/tea_guide_test?charset=utf8mb4

# === 会话 ===
# 必填：未配置将拒绝启动。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TEA_SECRET_KEY=
SESSION_EXPIRE_DAYS=30

# === 跨域 ===
TEA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# === 上传 ===
TEA_UPLOAD_DIR=uploads

# === 管理员初始账号 ===
# 生产部署必须通过环境变量注入，禁止使用内置默认密码；
# 轮换命令：python -m app.scripts.rotate_admin_password --password "新密码"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
