# 复制为 .env 后填写；本文件不含真实密钥
MM_PROFILE=prod

MM_DB_HOST=127.0.0.1
MM_DB_PORT=3306
MM_DB_ROOT_PASSWORD=change_me_root
MM_DB_NAME=mingmai
MM_DB_USER=mingmai
MM_DB_PASSWORD=change_me_db

MM_REDIS_URL=redis://127.0.0.1:6379/0
MM_STORAGE_DIR=./data/uploads

# 至少 32 字节，生产必须替换
MM_JWT_SECRET=change_me_to_a_random_secret_at_least_32_bytes

# 微信开放平台（生产必填）
MM_WECHAT_MOCK=false
MM_WECHAT_APPID=
MM_WECHAT_APP_SECRET=
