# 复制为 .env 后填写；本文件不含真实密钥
TEA_PROFILE=prod

TEA_DB_HOST=127.0.0.1
TEA_DB_PORT=3306
TEA_DB_ROOT_PASSWORD=change_me_root
TEA_DB_NAME=tea_atlas
TEA_DB_USER=tea_atlas
TEA_DB_PASSWORD=change_me_db

TEA_UPLOAD_DIR=./data/uploads

# 至少 32 字节，生产必须替换；tea-atlas 安全策略：缺失则拒绝启动
TEA_SECRET_KEY=change_me_to_a_random_secret_at_least_32_bytes

TEA_CORS_ORIGINS=https://your-domain.com
